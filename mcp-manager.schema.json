{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mcp-manager configuration",
  "description": "Central MCP definitions and scope assignments consumed by mcp-manager.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "global",
    "projects",
    "mcps"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional editor hint pointing to this JSON Schema."
    },
    "version": {
      "const": 2,
      "description": "Configuration format version."
    },
    "options": {
      "$ref": "#/$defs/options"
    },
    "global": {
      "$ref": "#/$defs/scope"
    },
    "projects": {
      "type": "object",
      "description": "Named projects and their project-scoped MCP assignments.",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "patternProperties": {
        "^[A-Za-z0-9_-]+$": {
          "$ref": "#/$defs/project"
        }
      },
      "additionalProperties": false
    },
    "mcps": {
      "type": "object",
      "description": "Reusable transport-only MCP definitions. Activation belongs to global or projects.",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "patternProperties": {
        "^[A-Za-z0-9_-]+$": {
          "$ref": "#/$defs/mcp"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inlineSecrets": {
          "type": "boolean",
          "default": false,
          "description": "Resolve envFrom and headersFrom and write their values into generated agent configs."
        },
        "stdioMode": {
          "type": "string",
          "enum": [
            "wrapper",
            "direct"
          ],
          "default": "wrapper",
          "description": "wrapper launches stdio servers through mcp-manager; direct writes the real command only for assignments without disabled tools. HTTP servers always run through mcp-manager."
        }
      }
    },
    "agent": {
      "type": "string",
      "enum": [
        "codex",
        "claude",
        "opencode"
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "mcpNames": {
      "type": "array",
      "description": "Unique MCP names defined by the top-level mcps object.",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "disabledAgents": {
      "type": "object",
      "description": "Active MCP names mapped to agents excluded only in this scope.",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "patternProperties": {
        "^[A-Za-z0-9_-]+$": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mcps"
      ],
      "properties": {
        "mcps": {
          "$ref": "#/$defs/mcpNames"
        },
        "disabledAgents": {
          "$ref": "#/$defs/disabledAgents"
        },
        "disabledTools": {
          "$ref": "#/$defs/disabledTools"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mcps"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Existing absolute project directory; a leading ~/ is also supported."
        },
        "includeWorktrees": {
          "type": "boolean",
          "default": false,
          "description": "Discover this repository's worktrees during sync and inherit this project's MCPs, agent exclusions and tool exclusions. Requires path to be a Git repository or worktree root."
        },
        "mcps": {
          "$ref": "#/$defs/mcpNames"
        },
        "disabledAgents": {
          "$ref": "#/$defs/disabledAgents"
        },
        "disabledTools": {
          "$ref": "#/$defs/disabledTools"
        }
      }
    },
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "noNulString": {
      "type": "string",
      "not": {
        "pattern": "\u0000"
      }
    },
    "environment": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "$ref": "#/$defs/noNulString"
        }
      },
      "additionalProperties": false
    },
    "headerName": {
      "type": "string",
      "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
    },
    "headers": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/headerName"
      },
      "patternProperties": {
        "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$": {
          "type": "string",
          "not": {
            "pattern": "[\r\n\u0000]"
          }
        }
      },
      "additionalProperties": false
    },
    "headersFrom": {
      "type": "object",
      "description": "HTTP header names mapped to environment variables whose values supply the headers.",
      "propertyNames": {
        "$ref": "#/$defs/headerName"
      },
      "patternProperties": {
        "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$": {
          "$ref": "#/$defs/environmentName"
        }
      },
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "stdio",
            "http",
            "sse"
          ]
        },
        "command": {
          "type": "string",
          "pattern": "\\S",
          "not": {
            "pattern": "\u0000"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noNulString"
          }
        },
        "env": {
          "$ref": "#/$defs/environment"
        },
        "envFrom": {
          "type": "array",
          "description": "Environment variable names forwarded without storing their values in the central config.",
          "items": {
            "$ref": "#/$defs/environmentName"
          },
          "uniqueItems": true
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "urlFrom": {
          "$ref": "#/$defs/environmentName",
          "description": "Environment variable holding the server URL, read when the server launches."
        },
        "headers": {
          "$ref": "#/$defs/headers"
        },
        "headersFrom": {
          "$ref": "#/$defs/headersFrom"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "stdio"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "command"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "url"
                  ]
                },
                {
                  "required": [
                    "urlFrom"
                  ]
                },
                {
                  "required": [
                    "headers"
                  ]
                },
                {
                  "required": [
                    "headersFrom"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "http",
                  "sse"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "urlFrom"
                ]
              }
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "args"
                  ]
                },
                {
                  "required": [
                    "env"
                  ]
                },
                {
                  "required": [
                    "envFrom"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "toolNames": {
      "type": "array",
      "description": "Exact MCP tool names, without agent/server prefixes or wildcard expansion.",
      "items": {
        "type": "string",
        "pattern": "\\S",
        "not": {
          "pattern": "[\\r\\n\\u0000]"
        }
      },
      "uniqueItems": true
    },
    "disabledTools": {
      "type": "object",
      "description": "Active MCP names mapped to tools hidden and blocked only in this scope, for every agent and transport.",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "patternProperties": {
        "^[A-Za-z0-9_-]+$": {
          "$ref": "#/$defs/toolNames"
        }
      },
      "additionalProperties": false
    }
  }
}
